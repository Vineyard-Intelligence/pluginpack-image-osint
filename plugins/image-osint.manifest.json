{
  "identifier": "run.vineyard.pluginpacks.image_osint",
  "content_type": "vineyard:pluginpack",
  "name": "Image OSINT",
  "version": "1.4.0",
  "description": "Extracts EXIF metadata and GPS location from photos, parsed locally without uploading them.",
  "author": {
    "name": "VINEYARD",
    "url": "https://github.com/Vineyard-Intelligence"
  },
  "license": "Apache-2.0",
  "icon": "image",
  "platforms": {
    "primary": "web",
    "web": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs"
    }
  },
  "plugins": [
    {
      "identifier": "run.vineyard.plugins.exif_extract",
      "content_type": "vineyard:plugin",
      "name": "EXIF Extract",
      "version": "2.1.1",
      "description": "Reads photos picked in the Run dialog (no selection), locally without uploading them. Creates a File node per photo with its SHA-256 and, for JPEGs, EXIF fields (camera make/model, body serial, lens, capture time, software), plus a Location node linked \"captured at\" when the photo has GPS coordinates.",
      "icon": "map-pin",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.endpoint",
            "category": "endpoint",
            "name": "file"
          },
          {
            "typepack": "run.vineyard.typepacks.geo",
            "category": "geo",
            "name": "location"
          }
        ]
      },
      "params": {
        "type": "object",
        "properties": {
          "images": {
            "type": "array",
            "format": "file",
            "accept": "image/*",
            "title": "Image files",
            "description": "One or more JPEG photos, read locally (never uploaded)."
          }
        },
        "required": [
          "images"
        ]
      },
      "scopes": {
        "graph": [
          "node:create",
          "edge:create"
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    }
  ]
}
