{
  "identifier": "run.vineyard.pluginpacks.image_osint",
  "content_type": "vineyard:pluginpack",
  "name": "Image OSINT",
  "version": "1.2.0",
  "description": "Browser-only image tools: reverse-image-search lead generation (Google Lens / Yandex / Bing / TinEye) and local EXIF/GPS extraction. No API keys, no server, and images never leave your machine.",
  "author": {
    "name": "vineyard-run",
    "url": "https://github.com/vineyard-run"
  },
  "license": "Apache-2.0",
  "icon": "image",
  "platforms": {
    "primary": "web",
    "web": {
      "runtime": "sandbox-js",
      "entry": "dist/pack.mjs"
    }
  },
  "plugins": [
    {
      "identifier": "run.vineyard.plugins.reverse_image_search",
      "content_type": "vineyard:plugin",
      "name": "Reverse Image Search",
      "version": "1.1.0",
      "description": "For each selected URL (an image link), creates ready-to-click reverse-image-search leads \u2014 Google Lens, Yandex, Bing, TinEye \u2014 as URL nodes. No network call; you open the leads yourself.",
      "icon": "image-search",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "web",
            "name": "url"
          }
        ],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.infrastructure",
            "category": "web",
            "name": "url"
          }
        ]
      },
      "scopes": {
        "graph": [
          "node:read",
          "node:create",
          "edge:create"
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    },
    {
      "identifier": "run.vineyard.plugins.exif_extract",
      "content_type": "vineyard:plugin",
      "name": "EXIF Extract",
      "version": "2.0.0",
      "description": "Reads locally-chosen JPEGs entirely in your browser: creates a File node with its SHA-256 for each, and, if a photo carries GPS EXIF, a Location node. Pick one photo or a whole batch \u2014 one run, one review. The images never leave your machine \u2014 no network.",
      "icon": "map-pin",
      "platforms": {
        "primary": "web",
        "web": {
          "runtime": "sandbox-js",
          "entry": "dist/pack.mjs"
        }
      },
      "io": {
        "consumes": [],
        "produces": [
          {
            "typepack": "run.vineyard.typepacks.endpoint",
            "category": "endpoint",
            "name": "file"
          },
          {
            "typepack": "run.vineyard.typepacks.geo",
            "category": "geo",
            "name": "location"
          }
        ]
      },
      "params": {
        "type": "object",
        "properties": {
          "images": {
            "type": "array",
            "format": "file",
            "accept": "image/*",
            "title": "Image files",
            "description": "One or more JPEG photos, read locally (never uploaded)."
          }
        },
        "required": [
          "images"
        ]
      },
      "scopes": {
        "graph": [
          "node:create",
          "edge:create"
        ]
      },
      "lifecycle": {
        "persistence": "opt-in",
        "controls": [
          "progress",
          "cancel"
        ],
        "progress": "determinate"
      }
    }
  ]
}
